                          "height": 421.27,
                          "effect": {
                            "type": "background_blur",
                            "radius": 8
                          }
                        },
                        {
                          "type": "frame",
                          "id": "GfUMD",
                          "name": "div",
                          "context": "div",
                          "width": "fill_container",
                          "height": 1339.33,
                          "layout": "vertical",
                          "padding": [
                            0,
                            0,
                            0.01,
                            0
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "B87oZj",
                              "name": "6. Hobby Herbstkegelturnier des HV TDP S",
                              "context": "h1",
                              "fill": "#ffffff",
                              "content": "6. Hobby Herbstkegelturnier des HV TDP Stainz",
                              "lineHeight": 1.3,
                              "fontFamily": "Roboto",
                              "fontSize": 28,
                              "fontWeight": "700",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "zcmBU",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "TuKad",
                              "name": "Frauental, 07.11.2026",
                              "context": "p",
                              "fill": "#ffffff",
                              "content": "Frauental, 07.11.2026",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "qIrmb",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "htxQJ",
                              "name": "Die kalte Jahreszeit kehrt ein, sportlic",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 60,
                              "content": "Die kalte Jahreszeit kehrt ein, sportliche Outdoor Veranstaltungen sind daher eher Mangelware. Gut dass es jedes Jahr im Herbst ein Alternativprogramm gibt und zwar beim jährlichen Herbstkegelturnier für Hobbyspieler vom HV TDP Stainz. Gespielt wurde in 2er Teams und wie gewohnt im Sportcafe Frauental. Das Turnier für Jung und Junggebliebene war mit 21 Mannschaften wieder einmal ausverkauft!",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "c5DjJL",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "JExWj",
                              "name": "Sportlich ging es in 3 Vorrundengruppen ",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 40,
                              "content": "Sportlich ging es in 3 Vorrundengruppen um den Aufstieg in die Zwischengruppen. An dieser Hürde scheiterten die Mannschaften „Pichlinger Laube“, „Die Schlumpfis“, „Promille Schieber“, „Die Stoarumpler“, „Die Bandenrambos“ und „Tyranosaufus Ex“.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "nugJ7",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "XPQWi",
                              "name": "Für die verbliebenen 15 Mannschaften gin",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 60,
                              "content": "Für die verbliebenen 15 Mannschaften ging es langsam aber sicher in die entscheidende Phase. Lediglich 8 Mannschaften konnten sich einen Platz für die KO-Phase sichern. Endstation in der Zwischengruppe war für die Mannschaften „R.E.D. Team – Retired Extremely Dangerous Team“, „West Coast Kegel Bro´s“, „Los Keglos“, „Die Bandenprofis“, „Net von Do“, „Team Phönix“ sowie „Double Trouble“.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "P7oUt6",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "M5KSNT",
                              "name": "Im Viertelfinale angelangt, durfte man s",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 100,
                              "content": "Im Viertelfinale angelangt, durfte man sich keinen Fehler bzw. Niederlage mehr erlauben. Im ersten Viertelfinale setzten sich „Die Alten“ gegen „Die Abräumer (manchmal)“ durch und standen somit als erstes Team im Halbfinale. „DaGo Hits 26“ ließen „Die Schwiegergeschwister“ keine Chance und zogen auch ins Halbfinale ein. „Die zwei bärenstarken Typen“ setzten sich im vorletzten Viertelfinale ganz knapp gegen „Die Turbotiger“ durch. Das letzte Viertelfinalticket konnte sich der Titelverteidiger „Die Schuggas“ nach einem Sieg gegen „Die Hadschis“ (extra aus der Bundeshauptstadt Wien angereist!) holen.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "KAlfr",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 28,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "v6kUs",
                              "name": "KO Phase",
                              "context": "h2",
                              "fill": "#ffffff",
                              "content": "KO Phase",
                              "lineHeight": 1.3,
                              "fontFamily": "Roboto",
                              "fontSize": 22.4,
                              "fontWeight": "700",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "d7tKbg",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 11.18,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "bGZdz",
                              "name": "Die letzten 4 Spiele des Tages sollten f",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 80,
                              "content": "Die letzten 4 Spiele des Tages sollten folgen. Die Zuschauer sahen gespannt zu und zeigten sich als faire Interessenten der Spiele. Im ersten Halbfinale konnte sich „DaGo Hits 26“ durchsetzen und standen somit im Finale. Für „Die Alten“ stand im Anschluss noch das Spiel um Platz 3 an. Das zweite Halbfinale war sehr hochklassig und es kam zu einer kleinen Sensation: „Die zwei bärenstarken Typen“ spielten eine sensationelle Runde, gewannen das zweite Halbfinale und schickten den Titelverteidiger „Die Schuggas“ ins Spiel um Platz 3.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "k4uSDf",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "OVPsm",
                              "name": "Bevor es zum großen Finale kam, wurde da",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 40,
                              "content": "Bevor es zum großen Finale kam, wurde das zuvor erwähnte Spiel um Platz 3 gespielt. Dort konnten sich „Die Schuggas“ gegen „Die Alten“ durchsetzen und mussten den Titel zwar abgeben, doch erreichten den tollen 3. Platz und standen am Podium.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "ljku7",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 14,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "Wn0ru",
                              "name": "Es kam zum Finale. Anfangs konnte sich k",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 60,
                              "content": "Es kam zum Finale. Anfangs konnte sich keine Mannschaft so richtig absetzen, doch ab ca. der Hälfte der Schübe zeichnete sich ab in welche Richtung sich das Spiel drehen würde. Am Ende konnte sich „DaGo Hits 26“ (Daniel und Gottfried Fabian) mit 294:212 gegen „Die zwei bärenstarken Typen“ durchsetzen und somit das 6. Hobby Herbstkegelturnier gewinnen!",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "X8CjfU",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 28,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "pVsaS",
                              "name": "Siegerehrung",
                              "context": "h2",
                              "fill": "#ffffff",
                              "content": "Siegerehrung",
                              "lineHeight": 1.3,
                              "fontFamily": "Roboto",
                              "fontSize": 22.4,
                              "fontWeight": "700",
                              "letterSpacing": 0.25
                            },
                            {
                              "type": "frame",
                              "id": "xZB30",
                              "name": "spacer",
                              "width": "fill_container",
                              "height": 11.18,
                              "layout": "none"
                            },
                            {
                              "type": "text",
                              "id": "te71I",
                              "name": "Bei der abschließenden Siegerehrung beda",
                              "context": "p",
                              "fill": "#ffffff",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 120,
                              "content": "Bei der abschließenden Siegerehrung bedankte sich die Turnierleitung Philipp Bohacek und Thomas Heritsch bei allen teilnehmenden Mannschaften für die fairen Spiele und der tollen Atmosphäre. Für jede Mannschaft gab es wie gewohnt eine Urkunde. Die Top 8 durften sich über Sachpreise freuen. Für die Top 3 kam auch noch ein Wanderpokal dazu. Abschließend wurde auch noch die stärkste Spielrunde geehrt. Diese erreichte an diesem Tag die Mannschaft „Los Keglos“ mit einer unglaublichen Punktezahl von 429! Somit ging die sechste Auflage des Kegelklassikers zu Ende und jeder Teilnehmer wartet jetzt schon gespannt auf die Ankündigung, wann sich alle Hobbykegler im Frühjahr wieder duellieren können.",
                              "lineHeight": 1.43,
                              "fontFamily": "Roboto",
                              "fontSize": 14,
                              "fontWeight": "normal",
                              "letterSpacing": 0.25
                            },
