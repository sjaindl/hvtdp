    {
      "name": "Fanshop",
      "description": "Fanshop items with base price (or price note), order options and image (`migrate-to-strapi.sh fanshop`). A choice price replaces the item price when chosen.",
      "item": [
        {
          "name": "List shop items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shop-items?sort[0]=order:asc&populate[image]=true&populate[optionGroups][populate][choices]=true&pagination[pageSize]=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shop-items"
              ],
              "query": [
                {
                  "key": "sort[0]",
                  "value": "order:asc"
                },
                {
                  "key": "populate[image]",
                  "value": "true"
                },
                {
                  "key": "populate[optionGroups][populate][choices]",
                  "value": "true"
                },
                {
                  "key": "pagination[pageSize]",
                  "value": "100"
                }
              ]
            },
            "description": "All items in display order, with image and option groups including their choices."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Items with price or price note', () => {",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  body.data.forEach((item) => {",
                  "    pm.expect(item).to.include.keys('name', 'description', 'category', 'price', 'priceNote', 'image', 'optionGroups');",
                  "    pm.expect(['Bekleidung', 'Accessoires', 'Sonstiges']).to.include(item.category);",
                  "    pm.expect(item.price !== null || !!item.priceNote, `${item.name} needs a price or a price note`).to.be.true;",
                  "  });",
                  "});",
                  "pm.test('Option groups are choices or text fields', () => {",
                  "  body.data.flatMap((item) => item.optionGroups).forEach((group) => {",
                  "    pm.expect(['Auswahl', 'Text']).to.include(group.kind);",
                  "    pm.expect(group.choices).to.be.an('array');",
                  "    if (group.kind === 'Auswahl') pm.expect(group.choices).to.not.be.empty;",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "description": "Downloads of the documents page (`migrate-to-strapi.sh documents`). Protected documents are delivered only by `POST /api/documents/:documentId/download` with the members' password; the public list does not contain their files.",
      "item": [
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/documents?sort[0]=order:asc&populate[0]=file&pagination[pageSize]=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ],
              "query": [
                {
                  "key": "sort[0]",
                  "value": "order:asc"
                },
                {
                  "key": "populate[0]",
                  "value": "file"
                },
                {
                  "key": "pagination[pageSize]",
                  "value": "100"
                }
              ]
            },
            "description": "All documents in display order. Protected documents come without `file`; they are only available via the download endpoint. Run this first: it stores `publicDocumentId` and `protectedDocumentId` for the download requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Documents with category, file and protected flag', () => {",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  body.data.forEach((doc) => {",
                  "    pm.expect(doc).to.include.keys('title', 'date', 'category', 'file', 'protected', 'order');",
                  "    pm.expect(['Allgemein', 'Turnierergebnisse', 'Protokolle']).to.include(doc.category);",
                  "    pm.expect(doc.protected).to.be.a('boolean');",
                  "  });",
                  "});",
                  "pm.test('Only public documents expose their file', () => {",
                  "  body.data.forEach((doc) => {",
                  "    if (doc.protected) pm.expect(doc.file, `${doc.title} must not expose its file`).to.be.null;",
                  "    else pm.expect(doc.file && doc.file.mime, `${doc.title} needs a PDF`).to.eql('application/pdf');",
                  "  });",
                  "});",
                  "// Used by the download requests below.",
                  "const publicDoc = body.data.find((doc) => !doc.protected);",
                  "const protectedDoc = body.data.find((doc) => doc.protected);",
                  "if (publicDoc) pm.environment.set('publicDocumentId', publicDoc.documentId);",
                  "if (protectedDoc) pm.environment.set('protectedDocumentId', protectedDoc.documentId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Download public document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{publicDocumentId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{publicDocumentId}}",
                "download"
              ]
            },
            "description": "Public documents need no password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Delivers the PDF as download', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Download protected document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"password\": \"{{documentsPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{protectedDocumentId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{protectedDocumentId}}",
                "download"
              ]
            },
            "description": "Protected document with the members' password (`documentsPassword` in the environment; the server compares it with DOCUMENTS_PASSWORD). Not cached (`Cache-Control: no-store`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Delivers the PDF as download', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});",
                  "pm.test('Not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Download protected document – wrong password",
